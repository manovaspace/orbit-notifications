# orbit-notifications — copy to .env for local dev (chmod 600). Never commit .env.

DEPLOYMENT_ENVIRONMENT=dev
# The `notifications` database is production; never use it for development.
DATABASE_URL=postgres://notifications_dev:<password>@127.0.0.1:10000/notifications_dev?sslmode=disable
GRPC_PORT=10012
HEALTH_PORT=10013
# Apply embedded migrations on start; set false when a deploy runs `migrate` first.
MIGRATE_ON_START=true
ORBIT_INTERNAL_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:10022

# SMTP (Stalwart in prod, Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=10024
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@manova.space

