# orbit-notifications — copy to .env for local dev (chmod 600). Never commit .env.

DEPLOYMENT_ENVIRONMENT=dev
DATABASE_URL=postgres://orbit:orbit@localhost:10332/notifications?sslmode=disable
GRPC_PORT=10110
HEALTH_PORT=10111
ORBIT_INTERNAL_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:10517

# SMTP (Stalwart in prod, Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=10725
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@manova.space

# Unleash Feature Flags
UNLEASH_URL=http://localhost:10050/api/
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
UNLEASH_APP_NAME=orbit-notifications
