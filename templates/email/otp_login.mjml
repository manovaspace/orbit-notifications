<mjml>
  <mj-head>
    <mj-title>Your Manova login code</mj-title>
    <mj-preview>{{.preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#0a0a0a" font-size="14px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fafafa">
    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="11px" color="#545454" padding-bottom="8px">Manova</mj-text>
        <mj-divider border-color="#e7e7e7" border-width="1px" padding="0 0 24px 0" />
        <mj-text font-size="22px" font-weight="600" padding-bottom="12px">Your login code</mj-text>
        <mj-text color="#545454" padding-bottom="20px">Use this code to sign in. It expires in {{.expires_in}}.</mj-text>
        <mj-text font-family="ui-monospace, 'SF Mono', Consolas, monospace" font-size="32px" font-weight="700" color="#2563eb" letter-spacing="6px" align="left" padding="8px 0 4px 0">{{.code}}</mj-text>
        <mj-divider border-color="#2563eb" border-width="2px" width="160px" align="left" padding="0 0 24px 0" />
        <mj-text font-size="11px" color="#545454">If you did not request this, ignore the message or write to security@manova.space. Never share this code.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
