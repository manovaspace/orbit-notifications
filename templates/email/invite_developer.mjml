<mjml>
  <mj-head>
    <mj-title>Welcome to Manova — developer workspace invitation</mj-title>
    <mj-preview>{{.preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#0a0a0a" font-size="14px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fafafa">
    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="11px" color="#545454" padding-bottom="8px">Manova</mj-text>
        <mj-divider border-color="#e7e7e7" border-width="1px" padding="0 0 24px 0" />
        <mj-text font-size="22px" font-weight="600" padding-bottom="12px">Welcome to the team</mj-text>
        <mj-text color="#545454" padding-bottom="20px">Welcome to Manova, {{.name}}. You have been invited to join the Manova engineering workspace.</mj-text>
        <mj-text color="#545454" padding-bottom="8px">CLI:</mj-text>
        <mj-text font-family="ui-monospace, 'SF Mono', Consolas, monospace" font-size="14px" font-weight="600" color="#2563eb" padding="4px 0 12px 0">{{.cli_command}}</mj-text>
        <mj-text color="#545454" padding-bottom="8px">Fresh machine:</mj-text>
        <mj-text font-family="ui-monospace, 'SF Mono', Consolas, monospace" font-size="14px" color="#2563eb" padding="4px 0 24px 0">{{.curl_command}}</mj-text>
        <mj-text font-size="11px" color="#545454">If you did not expect this invitation, contact security@manova.space.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
